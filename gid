def ensure_dir(p: str):
    Path(p).mkdir(parents=True, exist_ok=True)


def win_to_ffmpeg_path(p: str) -> str:
    return str(Path(p)).replace("\\", "/")


def run_cmd_live(cmd: List[str], on_line=None) -> int:
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)
    if on_line:
        for line in proc.stdout:
            on_line(line.rstrip())
    else:
        for line in proc.stdout:
            sys.stdout.write(line)
    proc.wait()
    return proc.returncode


def is_valid_ffmpeg_path(path: str) -> bool:
    """Проверяет, является ли путь действительным исполняемым файлом FFmpeg"""
    if not path:
        return False

    # Проверка абсолютного пути
    if os.path.isfile(path):
        return True

    # Проверка наличия в системном PATH
    for system_path in os.environ["PATH"].split(os.pathsep):
        full_path = os.path.join(system_path, path)
        if os.path.isfile(full_path):
            return True

    # Проверка с расширениями (для Windows)
    if sys.platform == "win32":
        for ext in [".exe", ".bat", ".cmd"]:
            if os.path.isfile(path + ext):
                return True
            for system_path in os.environ["PATH"].split(os.pathsep):
                full_path = os.path.join(system_path, path + ext)
                if os.path.isfile(full_path):
                    return True

    return False


def ffprobe_duration(video_path: str, ffprobe_path: str) -> float:
    # Проверяем доступность ffprobe
    if not is_valid_ffmpeg_path(ffprobe_path):
        raise RuntimeError(f"ffprobe не найден по пути: {ffprobe_path}")

    cmd = [
        ffprobe_path, "-v", "error",
        "-show_entries", "format=duration",
        "-of", "default=noprint_wrappers=1:nokey=1",
        video_path
    ]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode != 0:
            return 0.0
        return float(res.stdout.strip())
    except Exception:
        return 0.0


def extract_audio_to_wav(video_path: str, wav_path: str, ffmpeg_path: str, sr: int = 16000) -> None:
    # Проверяем доступность ffmpeg
    if not is_valid_ffmpeg_path(ffmpeg_path):
        raise RuntimeError(f"ffmpeg не найден по пути: {ffmpeg_path}")

    cmd = [
        ffmpeg_path, "-y",
        "-i", video_path,
        "-vn", "-ac", "1",
        "-ar", str(sr),
        "-f", "wav",
        wav_path
    ]
    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def compute_energy_peaks(wav_path: str, sr: int = 16000) -> Tuple[np.ndarray, np.ndarray]:
    y, sr = librosa.load(wav_path, sr=sr, mono=True)
    if np.max(np.abs(y)) > 0:
        y = y / np.max(np.abs(y))
    frame_length = 2048
    hop_length = 512
    rms = librosa.feature.rms(y=y, frame_length=2048, hop_length=512, center=True)[0]
    times = librosa.frames_to_time(np.arange(len(rms)), sr=sr, hop_length=hop_length)
    if np.max(rms) > 0:
        rms = rms / np.max(rms)
    rms_smooth = librosa.effects.harmonic(rms, margin=2.0)
    return times, rms_smooth


def pick_top_peaks(times: np.ndarray, energy: np.ndarray, n: int, min_distance_s: float) -> List[float]:
    if len(times) < 3 or n <= 0:
        return []
    dt = float(np.median(np.diff(times)))
    if not np.isfinite(dt) or dt <= 0:
        dt = 0.01
    min_distance_samples = max(1, int(min_distance_s / dt))
    peaks, props = find_peaks(energy, distance=min_distance_samples, prominence=np.std(energy) * 0.5)
    if len(peaks) == 0:
        return []
    scores = props["prominences"] if "prominences" in props else energy[peaks]
    order = np.argsort(scores)[::-1]
    top_peaks = peaks[order][:n]
    return sorted(times[top_peaks].tolist())


def propose_fallback_marks(duration: float, n: int, guard: float = 2.0) -> List[float]:
    if n <= 0:
        return []
    usable = max(0.0, duration - 2 * guard)
    if usable <= 0:
        return [min(duration / 2, max(0.0, duration - guard))]
    step = usable / (n + 1)
    return [guard + step * (i + 1) for i in range(n)]


def clamp_segment(center: float, pre: float, post: float, duration: float) -> Tuple[float, float]:
    start = max(0.0, center - pre)
    end = min(duration, center + post)
    target_len = pre + post
    cur_len = end - start
    if cur_len < target_len and duration >= target_len:
        deficit = target_len - cur_len
        shift_left = min(start, deficit / 2)
        shift_right = min(duration - end, deficit - shift_left)
        start -= shift_left
        end += shift_right
    return start, end


def transcribe_segment_with_whisper(
        video_path: str,
        start: float,
        duration: float,
        language: str,
        model_size: str,
        device: str,
        compute_type: str,
        ffmpeg_path: str
) -> List[srt.Subtitle]:
    from faster_whisper import WhisperModel

    with tempfile.TemporaryDirectory() as td:
        seg_wav = os.path.join(td, "seg.wav")
        cmd = [
            ffmpeg_path, "-y",
            "-ss", f"{start:.3f}",
            "-t", f"{duration:.3f}",
            "-i", video_path,
            "-vn", "-ac", "1",
            "-ar", "16000",
            "-f", "wav",
            seg_wav
        ]
        subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        model = WhisperModel(model_size, device=device, compute_type=compute_type)
        segments, info = model.transcribe(seg_wav, language=language, vad_filter=True,
                                          vad_parameters=dict(min_silence_duration_ms=200))
        subs = []
        idx = 1
        for seg in segments:
            start_s = max(0.0, seg.start)
            end_s = max(start_s, seg.end)
            content = seg.text.strip()
            subs.append(srt.Subtitle(
                index=idx,
                start=srt.srt_timestamp_to_timedelta(srt.timedelta_to_srt_timestamp(start_s)),
                end=srt.srt_timestamp_to_timedelta(srt.timedelta_to_srt_timestamp(end_s)),
                content=content
            ))
            idx += 1
        return subs


def write_srt(subs: List[srt.Subtitle], path: str):
    with open(path, "w", encoding="utf-8") as f:
        f.write(srt.compose(subs))


def build_filter_complex(
        subs_path: str,
        font_dir: str,
        font_name_hint: str,
        out_w: int,
        out_h: int,
        rotate_content_90: bool,
        sub_font_size: int,
        sub_outline: int,
        sub_alignment: int,
        sub_margin_v: int
) -> str:
    subs_path = win_to_ffmpeg_path(subs_path)
    font_dir = win_to_ffmpeg_path(font_dir)

    fg_scale = f"scale={out_w}:-2:flags=lanczos"
    fg_chain = (f"transpose=1,{fg_scale}") if rotate_content_90 else fg_scale

    bg_chain = f"scale={out_w}:{out_h}:force_original_aspect_ratio=increase,boxblur=20:1,crop={out_w}:{out_h}"
    overlay = "overlay=(W-w)/2:(H-h)/2"

    force_style = (
        f"FontName={font_name_hint},"
        f"FontSize={sub_font_size},"
        f"OutlineColour=&H000000&,BorderStyle=3,Outline={sub_outline},Shadow=0,"
        f"Alignment={sub_alignment},MarginV={sub_margin_v}"
    )

    filter_complex = (
        f"[0:v]split=2[bg][fg];"
        f"[bg]{bg_chain}[bg2];"
        f"[fg]{fg_chain}[fg2];"
        f"[bg2][fg2]{overlay},"
        f"subtitles='{subs_path}':fontsdir='{font_dir}':force_style='{force_style}'"
    )
    return filter_complex


def encode_segment(
        video_path: str,
        start: float,
        duration: float,
        srt_path: str,
        font_file: str,
        ffmpeg_path: str,
        out_path: str,
        rotate_content_90: bool,
        out_w: int,
        out_h: int,
        out_fps: int,
        nvenc_preset: str,
        nvenc_cq: int,
        nvenc_bitrate: str,
        nvenc_maxrate: str,
        nvenc_bufsize: str,
        on_line=None
):
    # Проверяем доступность ffmpeg
    if not is_valid_ffmpeg_path(ffmpeg_path):
        raise RuntimeError(f"ffmpeg не найден по пути: {ffmpeg_path}")

    ensure_dir(os.path.dirname(out_path))
    font_dir = os.path.dirname(font_file)

    filter_complex = build_filter_complex(
        subs_path=srt_path,
        font_dir=font_dir,
        font_name_hint=Path(font_file).stem,  # подсказка имени
        out_w=out_w,
        out_h=out_h,
        rotate_content_90=rotate_content_90,
        sub_font_size=54,
        sub_outline=6,
        sub_alignment=2,
        sub_margin_v=80
    )

    cmd = [
        ffmpeg_path, "-y",
        "-ss", f"{start:.3f}",
        "-t", f"{duration:.3f}",
        "-i", video_path,
        "-filter_complex", filter_complex,
        "-map", "0:a:0?",
        "-c:v", "h264_nvenc",
        "-rc", "vbr",
        "-cq", str(nvenc_cq),
        "-b:v", nvenc_bitrate,
        "-maxrate", nvenc_maxrate,
        "-bufsize", nvenc_bufsize,
        "-preset", nvenc_preset,
        "-pix_fmt", "yuv420p",
        "-r", str(out_fps),
        "-c:a", "aac",
        "-b:a", "160k",
        "-movflags", "+faststart",
        "-threads", "0",
        out_path
    ]
    code = run_cmd_live(cmd, on_line=on_line)
    if code != 0:
        raise RuntimeError(f"ffmpeg failed with code {code}")


@dataclass
class CutterConfig:
    input_dir: str = r"D:\tiktok\main_shorts"
    output_dir: str = r"D:\tiktok\output"
    font_path: str = r"C:\Users\giddary\PycharmProjects\PythonProject1\ofont.ru_Creepster.ttf"
    ffmpeg_path: str = "ffmpeg"  # Путь по умолчанию (ищет в PATH)
    ffprobe_path: str = "ffprobe"  # Путь по умолчанию

    num_shorts: int = 5
    seg_total_len: float = 20.0
    seg_pre: float = 6.0
    seg_post: float = 14.0
    min_gap_factor: float = 0.6  # дистанция между пиками = seg_total_len * factor

    language: str = "ru"
    whisper_model: str = "small"
    whisper_device: str = "cuda"  # "cuda" или "cpu"
    whisper_compute: str = "float16"  # "float16" для GPU

    out_w: int = 1080
    out_h: int = 1920
    fps: int = 30
    rotate90: bool = False

    nvenc_preset: str = "p4"  # p1..p7
    nvenc_cq: int = 19
    nvenc_bitrate: str = "8M"
    nvenc_maxrate: str = "12M"
    nvenc_bufsize: str = "16M"

    enable_subs: bool = True

    def save(self, path: str):
        with open(path, "w", encoding="utf-8") as f:
            json.dump(asdict(self), f, ensure_ascii=False, indent=2)

    @staticmethod
    def load(path: str) -> "CutterConfig":
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        cfg = CutterConfig()
        for k, v in data.items():
            if hasattr(cfg, k):
                setattr(cfg, k, v)
        return cfg


class CutterWorker(QtCore.QThread):
    progress_changed = QtCore.Signal(int)  # 0..100
    status_line = QtCore.Signal(str)
    finished_ok = QtCore.Signal()
    finished_err = QtCore.Signal(str)

    def __init__(self, cfg: CutterConfig, videos: List[str], parent=None):
        super().__init__(parent)
        self.cfg = cfg
        self.videos = videos
        self._cancel = False

    def cancel(self):
        self._cancel = True

    def log(self, msg: str):
        self.status_line.emit(msg)

    def run(self):
        try:
            self._run_impl()
            if not self._cancel:
                self.finished_ok.emit()
        except Exception as e:
            self.finished_err.emit(str(e))

    def _run_impl(self):
        cfg = self.cfg

        # Проверка доступности CUDA
        if cfg.whisper_device == "cuda":
            try:
                import torch
                if not torch.cuda.is_available():
                    self.log("CUDA недоступна! Переключаюсь на CPU")
                    cfg.whisper_device = "cpu"
            except ImportError:
                self.log("PyTorch не установлен, проверка CUDA невозможна")
            except Exception as e:
                self.log(f"Ошибка проверки CUDA: {str(e)}. Переключаюсь на CPU")
                cfg.whisper_device = "cpu"

        ensure_dir(cfg.output_dir)
        total_jobs = len(self.videos) * max(1, cfg.num_shorts)
        done_jobs = 0

        for vpath in self.videos:
            if self._cancel:
                return
            base = Path(vpath).stem
            self.log(f"=== Видео: {vpath}")

            try:
                duration = ffprobe_duration(vpath, cfg.ffprobe_path)
            except Exception as e:
                self.log(f"Ошибка получения длительности: {str(e)}")
                continue

            if duration <= 0:
                self.log("Не удалось получить длительность — пропуск.")
                continue
            self.log(f"Длительность: {duration:.2f} c")

            with tempfile.TemporaryDirectory() as td:
                try:
                    wav_path = os.path.join(td, "audio.wav")
                    extract_audio_to_wav(vpath, wav_path, cfg.ffmpeg_path, sr=16000)
                    times, energy = compute_energy_peaks(wav_path, sr=16000)
                except Exception as e:
                    self.log(f"Ошибка обработки аудио: {str(e)}")
                    continue

                min_gap = max(4.0, cfg.seg_total_len * cfg.min_gap_factor)
                centers = pick_top_peaks(times, energy, n=cfg.num_shorts, min_distance_s=min_gap)
                if len(centers) < cfg.num_shorts:
                    fallback = propose_fallback_marks(duration, cfg.num_shorts - len(centers),
                                                      guard=cfg.seg_total_len / 2)
                    centers = sorted(centers + fallback)[:cfg.num_shorts]

            pre, post = cfg.seg_pre, cfg.seg_post
            if abs((pre + post) - cfg.seg_total_len) > 1e-3:
                pre = cfg.seg_total_len * 0.35
                post = cfg.seg_total_len - pre

            segments = [clamp_segment(c, pre, post, duration) for c in centers][:cfg.num_shorts]

            for i, (ss, ee) in enumerate(segments, 1):
                if self._cancel:
                    return
                seg_dur = max(0.5, ee - ss)
                self.log(f"→ Сегмент {i}: {ss:.2f}–{ee:.2f} ({seg_dur:.2f} c)")

                with tempfile.TemporaryDirectory() as srt_td:
                    srt_path = os.path.join(srt_td, "subs.srt")
                    if cfg.enable_subs:
                        try:
                            subs = transcribe_segment_with_whisper(
                                video_path=vpath,
                                start=ss,
                                duration=seg_dur,
                                language=cfg.language,
                                model_size=cfg.whisper_model,
                                device=cfg.whisper_device,
                                compute_type=cfg.whisper_compute,
                                ffmpeg_path=cfg.ffmpeg_path
                            )
                            write_srt(subs, srt_path)
                        except Exception as e:
                            self.log(f"[WARN] Ошибка транскрипции: {e}. Продолжаем без субтитров.")
                            # пустой файл — ffmpeg все равно ожидает путь
                            with open(srt_path, "w", encoding="utf-8") as f:
                                f.write("")
                    else:
                        with open(srt_path, "w", encoding="utf-8") as f:
                            f.write("")

                    out_name = f"{base}_short_{i:02d}.mp4"
                    out_path = os.path.join(cfg.output_dir, out_name)

                    def on_ff_line(line: str):
                        # Можно распарсить прогресс, но оставим стрим логов
                        self.status_line.emit(line)

                    try:
                        encode_segment(
                            video_path=vpath,
                            start=ss,
                            duration=seg_dur,
                            srt_path=srt_path,
                            font_file=cfg.font_path,
                            ffmpeg_path=cfg.ffmpeg_path,
                            out_path=out_path,
                            rotate_content_90=cfg.rotate90,
                            out_w=cfg.out_w,
                            out_h=cfg.out_h,
                            out_fps=cfg.fps,
                            nvenc_preset=cfg.nvenc_preset,
                            nvenc_cq=cfg.nvenc_cq,
                            nvenc_bitrate=cfg.nvenc_bitrate,
                            nvenc_maxrate=cfg.nvenc_maxrate,
                            nvenc_bufsize=cfg.nvenc_bufsize,
                            on_line=on_ff_line
                        )
                    except Exception as e:
                        self.log(f"Ошибка кодирования сегмента: {str(e)}")
                        continue

                done_jobs += 1
                pct = int((done_jobs / max(1, total_jobs)) * 100)
                self.progress_changed.emit(pct)

        self.log("Готово.")


