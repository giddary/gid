def normalize_zone(value):
    if not value or value == "*" or value == "-":
        return None
    if isinstance(value, str):
        raw = value.replace("(", "").replace(")", "").replace(" ", "")
        parts = [int(x) for x in raw.split(",") if x]
        if len(parts) == 4:
            return tuple(parts)
        return None
    if isinstance(value, (list, tuple)) and len(value) == 4:
        return tuple(int(v) for v in value)
    return None


class InputTracker(QtCore.QObject):
    mouse_clicked = QtCore.Signal(int, int)
    key_pressed = QtCore.Signal(str)

    def __init__(self):
        super().__init__()
        self._mouse_listener = mouse.Listener(on_click=self._on_click)
        self._kb_listener = keyboard.Listener(on_press=self._on_press)

    def start(self):
        self._mouse_listener.start()
        self._kb_listener.start()

    def stop(self):
        self._mouse_listener.stop()
        self._kb_listener.stop()

    def _on_click(self, x, y, button, pressed):
        if pressed:
            self.mouse_clicked.emit(x, y)

    def _on_press(self, key):
        try:
            if hasattr(key, "char") and key.char:
                self.key_pressed.emit(key.char.lower())
            else:
                self.key_pressed.emit(str(key).replace("Key.", "").lower())
        except Exception:  # noqa: BLE001
            pass


class TrackerEngine(QtCore.QObject):
    task_updated = QtCore.Signal(int)
    pulse_task = QtCore.Signal(int)

    def __init__(self, tasks: List[Task]):
        super().__init__()
        self.tasks = tasks
        self.runtime = [RuntimeTaskState() for _ in tasks]
        self.last_click_pos = (-1, -1)
        self.last_key = ""
        self.last_key_at = 0.0
        self.timer = QtCore.QTimer()
        self.timer.timeout.connect(self.tick)

    def set_last_click(self, x: int, y: int):
        self.last_click_pos = (x, y)

    def set_last_key(self, key_name: str):
        self.last_key = key_name
        self.last_key_at = time.time()

    def start(self):
        self.timer.start(250)

    def stop(self):
        self.timer.stop()

    def tick(self):
        for i, task in enumerate(self.tasks):
            if task.current >= task.maximum or task.wip:
                continue
            seen = self._seen(task)
            state = self.runtime[i]
            trigger = task.trigger_type
            now = time.time()

            if trigger == "Увидел-Счетчик+1":
                if seen and state.present_since is None:
                    state.present_since = now
                    self._inc(i, 1)
                if not seen:
                    state.present_since = None

            elif trigger == "Увидел-Нажал-Счетчик+1":
                if seen and self._click_in_zone(task.click_zone):
                    self._inc(i, 1)

            elif trigger == "Увидел-Таймер+1":
                if seen:
                    if state.present_since is None:
                        state.present_since = now
                        state.last_increment_at = 0.0
                    state.absent_since = None
                    if now - state.last_increment_at >= 1.0:
                        state.last_increment_at = now
                        self._inc(i, 1)
                else:
                    if state.absent_since is None:
                        state.absent_since = now
                    elif now - state.absent_since > 3:
                        if task.current != 0:
                            task.current = 0
                            self.task_updated.emit(i)
                        state.present_since = None
                        state.last_increment_at = 0.0

            elif trigger == "Увидел-НажалКнопку-Подождал-Нажалкнопку":
                # phase 0: видим image1 и нажали кнопку
                # phase 1: ждем wait_time
                # phase 2: видим image2 и нажали кнопку
                if state.phase == 0:
                    if seen and self._key_pressed(task.button):
                        state.phase = 1
                        state.phase_started_at = now
                elif state.phase == 1:
                    if now - state.phase_started_at >= task.wait_time:
                        state.phase = 2
                elif state.phase == 2:
                    seen2 = self._seen(task, use_second=True)
                    if seen2 and self._key_pressed(task.button):
                        self._inc(i, 1)
                        state.phase = 0
                        state.phase_started_at = 0.0

    def _inc(self, idx: int, amount: int):
        task = self.tasks[idx]
        old = task.current
        task.current = min(task.maximum, task.current + amount)
        if task.current != old:
            self.task_updated.emit(idx)
            self.pulse_task.emit(idx)

    def _click_in_zone(self, zone: Optional[Tuple[int, int, int, int]]) -> bool:
        if zone is None:
            return True
        x, y = self.last_click_pos
        x1, y1, x2, y2 = zone
        return x1 <= x <= x2 and y1 <= y <= y2

    def _key_pressed(self, key_name: Optional[str]) -> bool:
        if not key_name:
            return False
        return self.last_key == key_name.lower() and (time.time() - self.last_key_at) <= 1.0

    def _seen(self, task: Task, use_second: bool = False) -> bool:
        image = task.image_path2 if use_second else task.image_path
        if not image or image in ("*", "-"):
            return False
        p = Path(image)
        if not p.exists():
            return False

        with mss.mss() as sct:
            monitor = sct.monitors[1]
            x1, y1, x2, y2 = task.search_zone if task.search_zone else (0, 0, monitor["width"], monitor["height"])
            region = {"left": x1, "top": y1, "width": max(1, x2 - x1), "height": max(1, y2 - y1)}
            screen = np.array(sct.grab(region))[:, :, :3]
        tpl = cv2.imread(str(p), cv2.IMREAD_COLOR)
        if tpl is None:
            return False
        if screen.shape[0] < tpl.shape[0] or screen.shape[1] < tpl.shape[1]:
            return False
        result = cv2.matchTemplate(screen, tpl, cv2.TM_CCOEFF_NORMED)
        _, max_val, _, _ = cv2.minMaxLoc(result)
        return max_val >= task.threshold


class TaskCard(QtWidgets.QFrame):
    pin_toggled = QtCore.Signal(str)

    def __init__(self, task: Task):
        super().__init__()
        self.task = task
        self.setObjectName("TaskCard")
        self.setFrameShape(QtWidgets.QFrame.StyledPanel)

        self.pin_btn = QtWidgets.QToolButton()
        self.pin_btn.setText("📌" if task.pinned else "📍")
        self.pin_btn.clicked.connect(self.toggle_pin)

        self.title_lbl = QtWidgets.QLabel(task.title)
        self.title_lbl.setStyleSheet("font-size:15px;font-weight:600;")
        self.meta_lbl = QtWidgets.QLabel(task.trigger_type)
        self.meta_lbl.setStyleSheet("color:#9aa0a6;")

        self.progress = QtWidgets.QProgressBar()
        self.progress.setRange(0, task.maximum)
        self.progress.setValue(task.current)
        self.progress.setFormat("WIP" if task.wip else "%v / %m")
        if task.wip:
            self.progress.setRange(0, 1)
            self.progress.setValue(0)

        left = QtWidgets.QVBoxLayout()
        left.addWidget(self.title_lbl)
        left.addWidget(self.meta_lbl)
        if task.note:
            note_lbl = QtWidgets.QLabel(task.note)
            note_lbl.setWordWrap(True)
            note_lbl.setStyleSheet("color:#b0b7c3;font-size:11px;")
            left.addWidget(note_lbl)
        left.addWidget(self.progress)

        row = QtWidgets.QHBoxLayout(self)
        row.addWidget(self.pin_btn)
        row.addLayout(left)

        self.anim = QtCore.QPropertyAnimation(self, b"windowOpacity", self)
        self.anim.setDuration(280)

        self.update_visual_state()

    def toggle_pin(self):
        self.task.pinned = not self.task.pinned
        self.pin_btn.setText("📌" if self.task.pinned else "📍")
        self.pin_toggled.emit(self.task.title)

    def set_progress(self, value: int):
        if not self.task.wip:
            self.progress.setValue(value)
        self.update_visual_state()

    def update_visual_state(self):
        done = self.task.current >= self.task.maximum and not self.task.wip
        if done:
            self.setStyleSheet("#TaskCard{background:#143824;border:1px solid #2fd176;border-radius:10px;padding:6px;}")
        else:
            self.setStyleSheet("#TaskCard{background:#1f2330;border:1px solid #2a3040;border-radius:10px;padding:6px;}")

    def pulse(self):
        self.anim.stop()
        self.setWindowOpacity(0.6)
        self.anim.setStartValue(0.6)
        self.anim.setEndValue(1.0)
        self.anim.start()


class MainWindow(QtWidgets.QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(APP_NAME)
        self.resize(1080, 760)

        self.tasks = self._load_tasks()
        self.current_page = 1
        self.max_page = max(t.page for t in self.tasks)
        self.cards: Dict[str, TaskCard] = {}

        self.engine = TrackerEngine(self.tasks)
        self.engine.task_updated.connect(self.on_task_updated)
        self.engine.pulse_task.connect(self.on_task_pulse)

        self.input_tracker = InputTracker()
        self.input_tracker.mouse_clicked.connect(self.engine.set_last_click)
        self.input_tracker.key_pressed.connect(self.engine.set_last_key)
        self.input_tracker.start()

        self._build_ui()
        self.refresh_list()

        self.engine.start()

    def closeEvent(self, event: QtGui.QCloseEvent):
        self.engine.stop()
        self.input_tracker.stop()
        self.save_tasks()
        event.accept()

    def _build_ui(self):
        root = QtWidgets.QWidget()
        self.setCentralWidget(root)
        main = QtWidgets.QVBoxLayout(root)

        top = QtWidgets.QHBoxLayout()
        title = QtWidgets.QLabel("🎯 GTA5RP Ежедневки")
        title.setStyleSheet("font-size:24px;font-weight:700;")
        top.addWidget(title)
        top.addStretch(1)

        self.page_lbl = QtWidgets.QLabel()
        top.addWidget(self.page_lbl)

        prev_btn = QtWidgets.QPushButton("←")
        next_btn = QtWidgets.QPushButton("→")
        prev_btn.clicked.connect(lambda: self.switch_page(-1))
        next_btn.clicked.connect(lambda: self.switch_page(1))
        top.addWidget(prev_btn)
        top.addWidget(next_btn)

        reset_btn = QtWidgets.QPushButton("Сбросить страницу")
        reset_btn.clicked.connect(self.reset_current_page)
        top.addWidget(reset_btn)

        main.addLayout(top)

        settings_box = QtWidgets.QGroupBox("Настройки / Заглушки")
        settings_layout = QtWidgets.QHBoxLayout(settings_box)
        self.tesseract_edit = QtWidgets.QLineEdit()
        self.tesseract_edit.setPlaceholderText(r"C:\Program Files\Tesseract-OCR\tesseract.exe")
        settings_layout.addWidget(QtWidgets.QLabel("Tesseract path:"))
        settings_layout.addWidget(self.tesseract_edit)

        save_cfg = QtWidgets.QPushButton("Сохранить конфиг")
        save_cfg.clicked.connect(self.save_config)
        settings_layout.addWidget(save_cfg)
        main.addWidget(settings_box)

        self.scroll = QtWidgets.QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.list_host = QtWidgets.QWidget()
        self.list_layout = QtWidgets.QVBoxLayout(self.list_host)
        self.list_layout.addStretch(1)
        self.scroll.setWidget(self.list_host)
        main.addWidget(self.scroll)

        self._apply_theme()
        self.load_config()

    def _apply_theme(self):
        self.setStyleSheet(
            """
            QMainWindow, QWidget { background:#11141c; color:#e9edf4; font-family:Segoe UI; }
            QPushButton { background:#2a3040; border:1px solid #3a445b; border-radius:8px; padding:6px 10px; }
            QPushButton:hover { background:#36425a; }
            QLineEdit { background:#191e29; border:1px solid #3a445b; border-radius:6px; padding:6px; }
            QGroupBox { border:1px solid #2f374a; border-radius:10px; margin-top: 8px; padding-top: 8px; }
            QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 3px; }
            QProgressBar { background:#111827; border:1px solid #2e3a4d; border-radius:6px; text-align:center; }
            QProgressBar::chunk { background:#5f85ff; border-radius:5px; }
            """
        )

    def refresh_list(self):
        while self.list_layout.count() > 1:
            item = self.list_layout.takeAt(0)
            w = item.widget()
            if w:
                w.deleteLater()

        page_tasks = [t for t in self.tasks if t.page == self.current_page]
        page_tasks.sort(key=lambda x: (not x.pinned, x.title.lower()))
        for task in page_tasks:
            card = TaskCard(task)
            card.pin_toggled.connect(self._on_pin_toggle)
            self.cards[task.title] = card
            self.list_layout.insertWidget(self.list_layout.count() - 1, card)

        self.page_lbl.setText(f"Страница {self.current_page}/{self.max_page}")

    def switch_page(self, delta: int):
        self.current_page = min(self.max_page, max(1, self.current_page + delta))
        self.refresh_list()

    def on_task_updated(self, idx: int):
        task = self.tasks[idx]
        card = self.cards.get(task.title)
        if card:
            card.set_progress(task.current)

    def on_task_pulse(self, idx: int):
        task = self.tasks[idx]
        card = self.cards.get(task.title)
        if card:
            card.pulse()

    def _on_pin_toggle(self, _title: str):
        self.refresh_list()

    def reset_current_page(self):
        for task in self.tasks:
            if task.page == self.current_page and not task.wip:
                task.current = 0
        self.refresh_list()

    def _load_tasks(self) -> List[Task]:
        if not DATA_FILE.exists():
            return [dataclasses.replace(t) for t in DEFAULT_TASKS]

        try:
            raw = json.loads(DATA_FILE.read_text(encoding="utf-8"))
            tasks = []
            for item in raw:
                item["search_zone"] = normalize_zone(item.get("search_zone"))
                item["click_zone"] = normalize_zone(item.get("click_zone"))
                tasks.append(Task(**item))
            return tasks
        except Exception:  # noqa: BLE001
            return [dataclasses.replace(t) for t in DEFAULT_TASKS]

    def save_tasks(self):
        payload = []
        for t in self.tasks:
            d = dataclasses.asdict(t)
            payload.append(d)
        DATA_FILE.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")

    def save_config(self):
        cfg = {"tesseract_path": self.tesseract_edit.text().strip()}
        CONFIG_FILE.write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")
        if pytesseract and cfg["tesseract_path"]:
            pytesseract.pytesseract.tesseract_cmd = cfg["tesseract_path"]

    def load_config(self):
        if not CONFIG_FILE.exists():
            return
        try:
            cfg = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
            path = cfg.get("tesseract_path", "")
            self.tesseract_edit.setText(path)
            if pytesseract and path:
                pytesseract.pytesseract.tesseract_cmd = path
        except Exception:  # noqa: BLE001
            pass


if __name__ == "__main__":
    app = QtWidgets.QApplication(sys.argv)
    win = MainWindow()
    win.show()
    sys.exit(app.exec())
