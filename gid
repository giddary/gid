@dataclass
class Task:
    title: str
    current: int
    maximum: int
    trigger_type: str
    search_zone: Optional[Tuple[int, int, int, int]]
    click_zone: Optional[Tuple[int, int, int, int]]
    image_path: Optional[str]
    image_path2: Optional[str]
    threshold: float
    page: int
    button: Optional[str] = None
    wait_time: int = 0
    pinned: bool = False
    note: str = ""
    wip: bool = False


@dataclass
class RuntimeTaskState:
    present_since: Optional[float] = None
    absent_since: Optional[float] = None
    last_increment_at: float = 0.0
    phase: int = 0
    phase_started_at: float = 0.0


