class PathPicker(QtWidgets.QWidget):
    changed = QtCore.Signal(str)

    def __init__(self, label: str, mode: str = "dir", start: str = "", parent=None):
        super().__init__(parent)
        self.mode = mode  # "dir" | "file"
        lay = QtWidgets.QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        self.lab = QtWidgets.QLabel(label)
        self.edit = QtWidgets.QLineEdit(start)
        self.btn = QtWidgets.QPushButton("Выбрать...")
        lay.addWidget(self.lab)
        lay.addWidget(self.edit, 1)
        lay.addWidget(self.btn)
        self.btn.clicked.connect(self.pick)
        self.edit.textChanged.connect(self.changed.emit)

    def pick(self):
        if self.mode == "dir":
            d = QtWidgets.QFileDialog.getExistingDirectory(self, "Выберите папку", self.edit.text() or os.getcwd())
            if d:
                self.edit.setText(d)
        else:
            f, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Выберите файл", self.edit.text() or os.getcwd(),
                                                         "Все файлы (*.*)")
            if f:
                self.edit.setText(f)

    def text(self) -> str:
        return self.edit.text().strip()

    def set_text(self, t: str):
        self.edit.setText(t)


