    def append_log(self, text: str):
        self.log.appendPlainText(text)

    def open_output_dir(self):
        path = self.cfg.output_dir or self.p_output.text()
        if not path:
            return
        QtGui.QDesktopServices.openUrl(QtCore.QUrl.fromLocalFile(path))

    def table_videos(self) -> List[str]:
        res = []
        for r in range(self.tbl.rowCount()):
            chk = self.tbl.cellWidget(r, 0)
            if isinstance(chk, QtWidgets.QCheckBox) and chk.isChecked():
                item = self.tbl.item(r, 1)
                if item:
                    res.append(item.data(QtCore.Qt.ItemDataRole.UserRole))
        return res

    def refresh_videos(self):
        in_dir = self.p_input.text().strip() or self.cfg.input_dir
        exts = (".mp4", ".mov", ".mkv", ".avi", ".m4v")
        files = []
        if os.path.isdir(in_dir):
            for name in os.listdir(in_dir):
                if name.lower().endswith(exts):
                    files.append(os.path.join(in_dir, name))
        self.tbl.setRowCount(0)

        # Получаем текущие пути из GUI
        ffprobe_path = self.p_ffprobe.text().strip()

        for f in files:
            row = self.tbl.rowCount()
            self.tbl.insertRow(row)
            chk = QtWidgets.QCheckBox()
            chk.setChecked(True)
            self.tbl.setCellWidget(row, 0, chk)

            it_name = QtWidgets.QTableWidgetItem(os.path.basename(f))
            it_name.setData(QtCore.Qt.ItemDataRole.UserRole, f)
            self.tbl.setItem(row, 1, it_name)

            try:
                dur = ffprobe_duration(f, ffprobe_path)
                dur_text = f"{dur:.2f}"
            except Exception as e:
                dur = 0.0
                dur_text = f"Ошибка: {str(e)}"

            it_dur = QtWidgets.QTableWidgetItem(dur_text)
            it_dur.setTextAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
            self.tbl.setItem(row, 2, it_dur)

    def pull_config(self) -> CutterConfig:
        cfg = CutterConfig()
        cfg.input_dir = self.p_input.text().strip()
        cfg.output_dir = self.p_output.text().strip()
        cfg.font_path = self.p_font.text().strip()
        cfg.ffmpeg_path = self.p_ffmpeg.text().strip()
        cfg.ffprobe_path = self.p_ffprobe.text().strip()

        cfg.num_shorts = int(self.sp_num.spin.value())
        cfg.seg_total_len = float(self.ds_total.spin.value())
        cfg.seg_pre = float(self.ds_pre.spin.value())
        cfg.seg_post = float(self.ds_post.spin.value())
        cfg.min_gap_factor = float(self.ds_gap.spin.value())

        cfg.enable_subs = self.cb_enable_subs.isChecked()
        cfg.language = self.cmb_lang.currentText()
        cfg.whisper_model = self.cmb_model.currentText()
        cfg.whisper_device = self.cmb_device.currentText()
        cfg.whisper_compute = self.cmb_compute.currentText()

        cfg.out_w = int(self.sp_w.spin.value())
        cfg.out_h = int(self.sp_h.spin.value())
        cfg.fps = int(self.sp_fps.spin.value())
        cfg.rotate90 = self.cb_rot.isChecked()

        cfg.nvenc_preset = self.cmb_preset.currentText()
        cfg.nvenc_cq = int(self.sp_cq.spin.value())
        cfg.nvenc_bitrate = self.ed_br.text().strip()
        cfg.nvenc_maxrate = self.ed_mr.text().strip()
        cfg.nvenc_bufsize = self.ed_bs.text().strip()

        return cfg

    def apply_config(self, cfg: CutterConfig):
        self.cfg = cfg
        self.p_input.set_text(cfg.input_dir)
        self.p_output.set_text(cfg.output_dir)
        self.p_font.set_text(cfg.font_path)
        self.p_ffmpeg.set_text(cfg.ffmpeg_path)
        self.p_ffprobe.set_text(cfg.ffprobe_path)

        self.sp_num.spin.setValue(cfg.num_shorts)
        self.ds_total.spin.setValue(cfg.seg_total_len)
        self.ds_pre.spin.setValue(cfg.seg_pre)
        self.ds_post.spin.setValue(cfg.seg_post)
        self.ds_gap.spin.setValue(cfg.min_gap_factor)

        self.cb_enable_subs.setChecked(cfg.enable_subs)
        self.cmb_lang.setCurrentText(cfg.language)
        self.cmb_model.setCurrentText(cfg.whisper_model)
        self.cmb_device.setCurrentText(cfg.whisper_device)
        self.cmb_compute.setCurrentText(cfg.whisper_compute)

        self.sp_w.spin.setValue(cfg.out_w)
        self.sp_h.spin.setValue(cfg.out_h)
        self.sp_fps.spin.setValue(cfg.fps)
        self.cb_rot.setChecked(cfg.rotate90)

        self.cmb_preset.setCurrentText(cfg.nvenc_preset)
        self.sp_cq.spin.setValue(cfg.nvenc_cq)
        self.ed_br.setText(cfg.nvenc_bitrate)
        self.ed_mr.setText(cfg.nvenc_maxrate)
        self.ed_bs.setText(cfg.nvenc_bufsize)

    def save_profile(self):
        path, _ = QtWidgets.QFileDialog.getSaveFileName(self, "Сохранить профиль", os.getcwd(), "JSON (*.json)")
        if not path:
            return
        cfg = self.pull_config()
        cfg.save(path)
        self.append_log(f"Профиль сохранён: {path}")

    def load_profile(self):
        path, _ = QtWidgets.QFileDialog.getOpenFileName(self, "Загрузить профиль", os.getcwd(), "JSON (*.json)")
        if not path:
            return
        cfg = CutterConfig.load(path)
        self.apply_config(cfg)
        self.append_log(f"Профиль загружен: {path}")

    def set_running(self, running: bool):
        self.btn_start.setEnabled(not running)
        self.btn_cancel.setEnabled(running)
        self.btn_refresh.setEnabled(not running)
        self.btn_save_prof.setEnabled(not running)
        self.btn_load_prof.setEnabled(not running)
        self.p_input.setEnabled(not running)
        self.p_output.setEnabled(not running)
        self.p_font.setEnabled(not running)
        self.p_ffmpeg.setEnabled(not running)
        self.p_ffprobe.setEnabled(not running)

    def start_processing(self):
        videos = self.table_videos()
        if not videos:
            QtWidgets.QMessageBox.warning(self, "Нет видео", "В списке нет выбранных видео.")
            return

        cfg = self.pull_config()

        # Проверка FFmpeg/FFprobe
        ffmpeg_valid = is_valid_ffmpeg_path(cfg.ffmpeg_path)
        ffprobe_valid = is_valid_ffmpeg_path(cfg.ffprobe_path)

        if not ffmpeg_valid or not ffprobe_valid:
            msg = "Не найдены исполняемые файлы:\n"
            if not ffmpeg_valid:
                msg += f"- FFmpeg: {cfg.ffmpeg_path}\n"
            if not ffprobe_valid:
                msg += f"- FFprobe: {cfg.ffprobe_path}\n"
            msg += "\nУкажите правильные пути в настройках."
            QtWidgets.QMessageBox.critical(self, "Ошибка FFmpeg", msg)
            return

        if not os.path.isdir(cfg.input_dir):
            QtWidgets.QMessageBox.warning(self, "Путь", "Неверная входная папка.")
            return
        if not os.path.isdir(cfg.output_dir):
            try:
                ensure_dir(cfg.output_dir)
            except Exception:
                QtWidgets.QMessageBox.warning(self, "Путь", "Не удалось создать выходную папку.")
                return
        if cfg.enable_subs and (not os.path.isfile(cfg.font_path)):
            QtWidgets.QMessageBox.warning(self, "Шрифт", "Файл шрифта не найден. Укажите корректный ttf.")
            return

        self.append_log("Старт обработки…")
        self.pb.setValue(0)
        self.set_running(True)

        self.worker = CutterWorker(cfg, videos)
        self.worker.status_line.connect(self.append_log)
        self.worker.progress_changed.connect(self.pb.setValue)
        self.worker.finished_ok.connect(self.on_finished_ok)
        self.worker.finished_err.connect(self.on_finished_err)
        self.worker.start()

    def cancel_processing(self):
        if self.worker:
            self.worker.cancel()
            self.append_log("Запрошена отмена…")

    def on_finished_ok(self):
        self.append_log("Готово!")
        self.set_running(False)

    def on_finished_err(self, err: str):
        self.append_log(f"Ошибка: {err}")
        self.set_running(False)


